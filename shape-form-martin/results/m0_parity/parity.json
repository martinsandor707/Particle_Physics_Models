 "floors_in_formula_code": {
  "statement": "No floor or clamp on T or x: particle_shape.kinetic(lnp, m) = p^2/(sqrt(p^2+m^2)+m) with p = exp(lnp), lnT = log(kinetic), x = (lnT - v0)/vs in ParticleShape.params (and proton_shape.VARS/params) are unclamped. The only lower bounds in this code act on other quantities: range_mm = softplus(raw/5)*5 + 1 mm (R(T) >= 1 mm), (Z/Rr).clamp(-1, 1.5) in the track depth term, Lt.clamp_min(1e-12) in the tied weights, u.clamp(0,1) (bragg), Z.clamp_min(1.0) (ms), Z.clamp_min(0) (att/far), long_gamma's softplus + 1e-3; outside: WithAcceptance logA = log(Abar.clamp_min(1e-6)) and common.event_nll mass.clamp_min(1e-8). The MLP input lnp/3 is unbounded.",
  "lines": {
   "particle_shape.py": [
    "125: xc = x.clamp_min(1e-3)",
    "129: q = torch.sigmoid((self.SRC[None] - zst) / 3.0) * torch.exp(-(self.SRC[None] - zst).clamp_min(0) / lam) * self.DS / lam   # (B, Ns)",
    "132: back = torch.exp(g(\"log_fb\")) * face.mean(1, keepdim=True) * torch.exp(-(zst - zc).clamp_min(0) / torch.exp(g(\"log_lb\")))",
    "152: lt = lt - Z.clamp_min(0) / torch.exp(th[\"log_latt\"])",
    "154: u = (Z / self.range_mm(th)).clamp(0.0, 1.0)",
    "163: sig = torch.sqrt(st * st + (torch.exp(th[\"log_cms\"]) * (Z.clamp_min(1.0) / 1000) ** th[\"ms_pow\"] / bp) ** 2)",
    "186: cf = norm(F.logsigmoid(Z / 10.0) - Z.clamp_min(0) / torch.exp(th[\"log_Lf\"]) - R / torch.exp(th[\"log_Rf\"]) - torch.log(R + 10.0))"
   ],
   "proton_shape.py": [
    "121: return F.softplus(raw / 5.0) * 5.0 + 1.0",
    "126: lon = F.logsigmoid((Z - th[\"zt0\"]) / 4.0) + F.logsigmoid((Rr - Z) / wR) - th[\"kap\"] * (Z / Rr).clamp(-1.0, 1.5)",
    "150: Lt = F.softplus((self.range_mm(th) - th[\"zt0\"]) / 5.0) * 5.0",
    "151: l_f1, l_nf1 = torch.log(d1) - torch.log(d1 + Lt), torch.log(Lt.clamp_min(1e-12)) - torch.log(d1 + Lt)"
   ],
   "families.py": [
    "37: \"\"\"Gamma-profil a 00_common `long_gamma` alakj\u00e1ban: s^(alpha-1) e^{-(alpha-1) s / tmax}, s = softplus(z - z0).\"\"\"",
    "38: s = F.softplus((z - z0) / 2) * 2 + 1e-3"
   ]
  }
 },
